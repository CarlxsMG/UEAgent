{
  "mode": "typed_setter",
  "cmd_base": "exponential_height_fog",
  "actor_class": "AExponentialHeightFog",
  "article": "an",
  "component_class": "UExponentialHeightFogComponent",
  "accessor": "GetComponent()",
  "loctext_key": "SetExpHeightFogProperties",
  "set_desc": "Set an ExponentialHeightFog actor's fog component, actor found by label or name in the editor world: density, falloff, inscattering, distances, max opacity, volumetric fog, second fog layer, directional inscattering. Over set_properties it needs no component path and goes through the component's own setters; other fog properties: set_properties. Supplied fields only, one undo step, not saved (save_level); applied_count counts them and every property is read back. Colors are [R,G,B(,A)] floats, volumetric_fog_albedo [R,G,B(,A)] whole 0-255 bytes. Every field is checked before any write: a color that is not 3 or 4 numbers, a byte color with a fraction or a value past 255, a number given as a string or a non-boolean volumetric_fog is an error and nothing changes.",
  "get_desc": "Read the fog of an ExponentialHeightFog actor's component, found by label or name in the editor world, under the snake_case names set_exponential_height_fog_properties takes (density, falloff, inscattering, distances, volumetric fog, second layer). A curated view; get_properties (internal names only) reads any other UPROPERTY on the component.",
  "set_retired": "set_properties - object_path=\"<actor>.ExponentialHeightFogComponent\", properties={\"FogDensity\":..,\"FogHeightFalloff\":..,\"FogInscatteringLuminance\":{\"R\",\"G\",\"B\",\"A\"},\"SecondFogData\":{\"FogDensity\":..}}",
  "get_retired": "get_properties - object_path=\"<actor>.ExponentialHeightFogComponent\", property_names=[\"FogDensity\",\"FogHeightFalloff\",...], or get_component_properties for all of them",
  "fields": [
    { "json": "fog_density", "setter": "SetFogDensity", "readback": "FogDensity", "type": "float", "desc": "Optional global fog density." },
    { "json": "fog_height_falloff", "setter": "SetFogHeightFalloff", "readback": "FogHeightFalloff", "type": "float", "desc": "Optional height falloff." },
    { "json": "fog_inscattering_color", "setter": "SetFogInscatteringColor", "readback": "FogInscatteringLuminance", "type": "linear_color", "desc": "Optional [R,G,B(,A)] inscattering color (luminance).",
      "reader_comment": ["SetFogInscatteringColor writes FogInscatteringLuminance."] },
    { "json": "fog_max_opacity", "setter": "SetFogMaxOpacity", "readback": "FogMaxOpacity", "type": "float", "desc": "Optional max opacity (0..1)." },
    { "json": "start_distance", "setter": "SetStartDistance", "readback": "StartDistance", "type": "float", "desc": "Optional fog start distance." },
    { "json": "end_distance", "setter": "SetEndDistance", "readback": "EndDistance", "type": "float", "desc": "Optional fog end distance." },
    { "json": "fog_cutoff_distance", "setter": "SetFogCutoffDistance", "readback": "FogCutoffDistance", "type": "float", "desc": "Optional fog cutoff distance." },
    { "json": "volumetric_fog", "setter": "SetVolumetricFog", "readback": "bEnableVolumetricFog", "type": "bool", "desc": "Optional enable volumetric fog." },
    { "json": "volumetric_fog_scattering_distribution", "setter": "SetVolumetricFogScatteringDistribution", "readback": "VolumetricFogScatteringDistribution", "type": "float", "desc": "Optional volumetric scattering distribution (-1..1)." },
    { "json": "volumetric_fog_albedo", "setter": "SetVolumetricFogAlbedo", "readback": "VolumetricFogAlbedo", "type": "color_bytes", "desc": "Optional [R,G,B] or [R,G,B,A] volumetric albedo, each a whole number from 0 to 255 (FColor; A defaults to 255)." },
    { "json": "volumetric_fog_emissive", "setter": "SetVolumetricFogEmissive", "readback": "VolumetricFogEmissive", "type": "linear_color", "desc": "Optional [R,G,B(,A)] volumetric emissive color." },
    { "json": "volumetric_fog_extinction_scale", "setter": "SetVolumetricFogExtinctionScale", "readback": "VolumetricFogExtinctionScale", "type": "float", "desc": "Optional volumetric extinction scale." },
    { "json": "second_fog_density", "setter": "SetSecondFogDensity", "readback": "SecondFogData.FogDensity", "type": "float", "desc": "Optional second fog layer density." },
    { "json": "second_fog_height_falloff", "setter": "SetSecondFogHeightFalloff", "readback": "SecondFogData.FogHeightFalloff", "type": "float", "desc": "Optional second fog layer height falloff." },
    { "json": "second_fog_height_offset", "setter": "SetSecondFogHeightOffset", "readback": "SecondFogData.FogHeightOffset", "type": "float", "desc": "Optional second fog layer height offset." },
    { "json": "directional_inscattering_exponent", "setter": "SetDirectionalInscatteringExponent", "readback": "DirectionalInscatteringExponent", "type": "float", "desc": "Optional directional inscattering exponent (sun glow tightness)." },
    { "json": "directional_inscattering_start_distance", "setter": "SetDirectionalInscatteringStartDistance", "readback": "DirectionalInscatteringStartDistance", "type": "float", "desc": "Optional directional inscattering start distance." },
    { "json": "directional_inscattering_color", "setter": "SetDirectionalInscatteringColor", "readback": "DirectionalInscatteringLuminance", "type": "linear_color", "desc": "Optional [R,G,B(,A)] directional inscattering color (luminance).",
      "reader_comment": ["SetDirectionalInscatteringColor writes DirectionalInscatteringLuminance; DirectionalInscatteringColor_DEPRECATED", "keeps its default, so it does not round-trip."] }
  ]
}
